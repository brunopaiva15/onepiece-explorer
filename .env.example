# --------------------------------------------------------------------------
# One Piece Explorer — copy to .env.local and fill in.
# Nothing in this file is read at build time; all secrets stay server-side.
# --------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project URL and anon key. The anon key is used ONLY for the authentication
# round-trip and for consuming signed asset URLs. It is never used to read a
# table: all knowledge reads go through the Next.js server and withBoundary(),
# because the chapter boundary is a per-transaction session variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Storage administration and privileged maintenance.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database connections -------------------------------------------------
# Application reads. Supavisor in TRANSACTION mode (port 6543).
# postgres.js runs with prepare:false against this pooler, and every read
# happens inside a transaction so `SET LOCAL` cannot leak across connections.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Migrations, pg-boss worker and the ingestion pipeline. Direct connection
# (port 5432): long-lived connections and a dedicated schema do not suit the
# transaction pooler.
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Local PostgreSQL used by the test suite. Hermetic, no network.
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/onepiece_explorer_test

# --- Storage --------------------------------------------------------------
# Private bucket. Must NOT be public: original pages and derivatives are only
# ever reachable through short-lived signed URLs.
SUPABASE_STORAGE_BUCKET=chapters
# 'supabase' (default) or 'local' (tests / offline development)
STORAGE_DRIVER=supabase
LOCAL_STORAGE_ROOT=./var/storage
# Lifetime of a signed asset URL, in seconds.
SIGNED_URL_TTL_SECONDS=60

# --- Anthropic ------------------------------------------------------------
# Without a key the pipeline falls back to the synthetic provider and the UI
# says so plainly. Extraction shown in that mode is generated, not real.
ANTHROPIC_API_KEY=

# 'anthropic' (default) | 'replay' (CI) | 'synthetic' (no-key fallback)
MODEL_PROVIDER=anthropic

# Model routing. Cheap classification -> workhorse -> escalation.
MODEL_CLASSIFY=claude-haiku-4-5
MODEL_EXTRACT=claude-sonnet-5
MODEL_ESCALATE=claude-opus-5

# Send bulk panel extraction through the Message Batches API (50% cheaper).
# Import is asynchronous by design, so this is the right default.
USE_BATCH_API=true

# Confidence below which a panel is escalated to the stronger model.
ESCALATION_CONFIDENCE_THRESHOLD=0.6

# --- Ingestion limits (defence in depth on untrusted uploads) -------------
MAX_UPLOAD_BYTES=524288000
MAX_PAGES_PER_CHAPTER=120
MAX_PIXELS_PER_PAGE=40000000
MAX_ARCHIVE_ENTRIES=500
MAX_DECOMPRESSION_RATIO=120
