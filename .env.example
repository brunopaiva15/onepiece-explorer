# --------------------------------------------------------------------------
# One Piece Explorer — copy to .env.local and fill in.
# Nothing in this file is read at build time; all secrets stay server-side.
# --------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project URL and anon key. The anon key is used ONLY for the authentication
# round-trip and for consuming signed asset URLs. It is never used to read a
# table: all knowledge reads go through the Next.js server and withBoundary(),
# because the chapter boundary is a per-transaction session variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Storage administration and privileged maintenance.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database connections -------------------------------------------------
# Application reads. Supavisor in TRANSACTION mode (port 6543).
# postgres.js runs with prepare:false against this pooler, and every read
# happens inside a transaction so `SET LOCAL` cannot leak across connections.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Migrations, pg-boss worker and the ingestion pipeline. Direct connection
# (port 5432): long-lived connections and a dedicated schema do not suit the
# transaction pooler.
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Local PostgreSQL used by the test suite. Hermetic, no network.
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/onepiece_explorer_test

# --- Storage --------------------------------------------------------------
# Private bucket. Must NOT be public: original pages and derivatives are only
# ever reachable through short-lived signed URLs.
SUPABASE_STORAGE_BUCKET=chapters
# 'supabase' (default) or 'local' (tests / offline development)
STORAGE_DRIVER=supabase
LOCAL_STORAGE_ROOT=./var/storage
# Lifetime of a signed asset URL, in seconds.
SIGNED_URL_TTL_SECONDS=60

# --- Anthropic ------------------------------------------------------------
# Without a key the pipeline falls back to the synthetic provider and the UI
# says so plainly. Extraction shown in that mode is generated, not real.
ANTHROPIC_API_KEY=

# 'anthropic' (default) | 'replay' (CI) | 'synthetic' (no-key fallback)
MODEL_PROVIDER=anthropic

# The conversational assistant (/ask), OFF unless this is exactly '1'.
# A separate switch from the key above, and deliberately so: processing a
# chapter is one deliberate act with a known cost, while /ask bills per
# question, forever, at the speed someone can type. Having a key so the
# pipeline can read your pages must not silently open a metered box.
# Search — full text, fuzzy and graph — covers the same data for nothing.
ASSISTANT_ENABLED=

# Model routing, cheapest first. The one that matters for the bill is
# MODEL_DESCRIBE: a hundred panels per chapter, each carrying an image, is most
# of the spend on its own — and describing what is drawn, without naming anyone
# and without inferring, is the least demanding work in the pipeline.
# MODEL_EXTRACT is where a stronger model earns its price: entities, relations
# and events against the ontology. A weaker one there does not hallucinate into
# the graph (anchoring stops that) — it just finds less, and nobody learns what
# it missed.
# --- Self-hosted model (optional) ----------------------------------------
# An OpenAI-compatible endpoint — LM Studio, llama.cpp, vLLM. Setting the URL
# and the model is the decision to use it: the tiers listed in LOCAL_AI_TIERS
# go there, everything else falls through to the provider above. Name no tiers
# and it takes all of them.
#
# The endpoint usually listens on localhost of the machine holding the weights,
# so the worker has to run on that machine or reach it through a tunnel. It is
# never called from the browser.
#
# Cost is reported as zero for these calls, deliberately: the bill is
# electricity, and an invented figure would corrupt the cost dashboard.
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
# Unlocks the semantic indexing step, which has declared itself skipped since
# the pipeline was written — Anthropic exposes no embeddings endpoint.
LOCAL_AI_EMBED_MODEL=
LOCAL_AI_API_KEY=
# classify, describe, extract, escalate, embed — comma separated. Empty = all.
# Moving one tier at a time is how you find out whether a smaller model is good
# enough at a given job: same chapter, compare the quarantine counts.
LOCAL_AI_TIERS=
# Tokens spent deliberating are GPU seconds producing no field of the answer.
LOCAL_AI_REASONING_EFFORT=none

MODEL_CLASSIFY=claude-haiku-4-5
MODEL_DESCRIBE=claude-haiku-4-5
MODEL_EXTRACT=claude-sonnet-5
MODEL_ESCALATE=claude-opus-5

# Send bulk panel extraction through the Message Batches API (50% cheaper).
# Import is asynchronous by design, so this is the right default.
USE_BATCH_API=true

# Confidence below which a panel is escalated to the stronger model.
ESCALATION_CONFIDENCE_THRESHOLD=0.6

# --- Public reading -------------------------------------------------------
# Whose library anonymous visitors may read. Absent — the default — means the
# site is private: every page requires signing in, exactly as before.
#
# Set it to your own library id (shown in /reglages) and anyone may explore the
# graph, the timeline, the entity sheets and the search, with their own chapter
# slider. What stays behind authentication either way: the page and panel
# images, import, review, publication, deletion, export, enrichment and the
# assistant. Publishing the graph is what a fan wiki does; publishing the scans
# would be redistribution.
#
# A malformed value is treated as absent — a typo makes the site private
# rather than crashing it or half-opening it.
PUBLIC_LIBRARY_OWNER_ID=

# --- Illustrations --------------------------------------------------------
# Portraits, Devil Fruits, ships and islands are matched by name against three
# free public catalogues (onepieceapi.com, api-onepiece.com, AniList), then
# copied into the private bucket. No key, no account, nothing to configure.
# They are illustrations, never sources: no assertion may cite one.
#
# Where the fetched catalogue is cached. `pnpm images:catalogue` writes it;
# the test suite points this at a fixture so no test opens a socket.
IMAGE_CATALOGUE_PATH=./var/cache/image-catalogue.json

# --- Ingestion limits (defence in depth on untrusted uploads) -------------
MAX_UPLOAD_BYTES=524288000
MAX_PAGES_PER_CHAPTER=120
MAX_PIXELS_PER_PAGE=40000000
MAX_ARCHIVE_ENTRIES=500
MAX_DECOMPRESSION_RATIO=120
