# --------------------------------------------------------------------------
# One Piece Explorer — copy to .env.local and fill in.
# Nothing in this file is read at build time; all secrets stay server-side.
# --------------------------------------------------------------------------

# --- Supabase -------------------------------------------------------------
# Project URL and anon key. The anon key is used ONLY for the authentication
# round-trip and for consuming signed asset URLs. It is never used to read a
# table: all knowledge reads go through the Next.js server and withBoundary(),
# because the chapter boundary is a per-transaction session variable.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Storage administration and privileged maintenance.
# Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database connections -------------------------------------------------
# Application reads. Supavisor in TRANSACTION mode (port 6543).
# postgres.js runs with prepare:false against this pooler, and every read
# happens inside a transaction so `SET LOCAL` cannot leak across connections.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Migrations, pg-boss worker and the ingestion pipeline. Direct connection
# (port 5432): long-lived connections and a dedicated schema do not suit the
# transaction pooler.
DIRECT_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Local PostgreSQL used by the test suite. Hermetic, no network.
TEST_DATABASE_URL=postgresql://postgres@localhost:5432/onepiece_explorer_test

# --- Storage --------------------------------------------------------------
# Private bucket. Must NOT be public: original pages and derivatives are only
# ever reachable through short-lived signed URLs.
SUPABASE_STORAGE_BUCKET=chapters
# 'supabase' (default) or 'local' (tests / offline development)
STORAGE_DRIVER=supabase
LOCAL_STORAGE_ROOT=./var/storage
# Lifetime of a signed asset URL, in seconds.
SIGNED_URL_TTL_SECONDS=60

# --- Claude Max (abonnement) ----------------------------------------------
# Le chemin par défaut du traitement des chapitres : le Claude Agent SDK,
# authentifié par l'abonnement Claude Max plutôt que par l'API facturée au
# token. Générez le jeton sur votre machine avec :
#
#     claude setup-token
#
# puis collez-le ici en local, et dans les variables du projet chez votre
# hébergeur pour le déploiement. Jamais préfixé NEXT_PUBLIC_, jamais renvoyé
# dans une réponse : il n'est lu que côté serveur.
#
# Quota atteint = le traitement échoue avec un message explicite. Aucune
# bascule automatique vers ANTHROPIC_API_KEY, donc aucune facturation surprise.
CLAUDE_CODE_OAUTH_TOKEN=

# Où Claude s'exécute.
#   auto (défaut) — bac à sable en déploiement, sous-processus en local
#   inline        — le SDK lance Claude Code comme processus fils de celui-ci
#   sandbox       — Claude Code tourne dans un Vercel Sandbox (microVM)
# Le SDK a besoin d'un système de fichiers inscriptible et du droit de lancer un
# processus ; une fonction serverless n'offre ni l'un ni l'autre confortablement,
# d'où le bac à sable en déploiement.
#
# `inline` en déploiement demande deux choses de plus, et les deux ensemble.
# Le CLI est un binaire natif de trois cents mégaoctets, livré par un paquet
# optionnel propre à la plateforme : poser cette variable à `inline` l'embarque
# dans le build (voir claudeCodeFiles dans next.config.ts), et il faut aussi
# autoriser la fonction à dépasser les 250 Mo réglementaires —
# VERCEL_SUPPORT_LARGE_FUNCTIONS=1, qui demande Fluid compute et monte la
# limite à 5 Go. Sans la seconde, le déploiement échoue sur la taille ; sans la
# première, il passe et le premier appel dit « Native CLI binary not found ».
#
# Ce qu'on y perd de toute façon : Claude tourne dans la fonction elle-même,
# donc sous sa durée maximale (300 s en Hobby), ce qui convient à un appel par
# invocation — le balayage des mystères, la revue — et pas à un chapitre.
#
# La troisième voie ne passe pas par l'hébergeur du tout : le bouton
# « Réparations (production) » dans les Actions GitHub lance `repair:mysteres`
# et `repair:identites` sur un runner, où le SDK s'installe normalement. Ni bac
# à sable, ni limite de taille, ni limite de durée à cinq minutes.
CLAUDE_AGENT_RUNTIME=auto
# Délai maximal d'un appel Claude, en millisecondes (défaut : 600000, 10 min).
CLAUDE_AGENT_TIMEOUT_MS=
# Version du SDK installée dans le bac à sable. Défaut : celle de package.json.
CLAUDE_AGENT_SDK_VERSION=
# Durée de vie d'un bac à sable (défaut : 1800000, 30 min) et délai d'inactivité
# avant son arrêt (défaut : 180000, 3 min). Le bac à sable est créé au premier
# appel d'un traitement et réutilisé par tous les suivants : l'installation du
# SDK n'est payée qu'une fois par chapitre, pas une fois par appel.
CLAUDE_SANDBOX_TIMEOUT_MS=
CLAUDE_SANDBOX_IDLE_MS=

# Vercel Sandbox, en local uniquement. En déploiement l'authentification passe
# par le jeton OIDC du projet (activez « Secure Backend Access ») et ces trois
# variables sont inutiles. Sur une machine, CLAUDE_AGENT_RUNTIME=inline évite
# d'en avoir besoin du tout.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# --- Anthropic (API facturée, optionnelle) --------------------------------
# Conservée, mais plus le chemin par défaut. Utile pour comparer les deux, ou
# si vous n'avez pas d'abonnement Claude Max. Rien ne bascule dessus tout seul :
# c'est un choix explicite, jamais un repli.
ANTHROPIC_API_KEY=

# Vide (défaut) = le premier fournisseur configuré, dans cet ordre :
#   CLAUDE_CODE_OAUTH_TOKEN → claude-max
#   ANTHROPIC_API_KEY       → anthropic
#   ni l'un ni l'autre      → synthetic (extraction générée, bannière dans l'UI)
# Valeurs explicites : 'claude-max' | 'anthropic' | 'replay' (CI) | 'synthetic'
MODEL_PROVIDER=

# The conversational assistant (/ask), OFF unless this is exactly '1'.
# A separate switch from the key above, and deliberately so: processing a
# chapter is one deliberate act with a known cost, while /ask bills per
# question, forever, at the speed someone can type. Having a key so the
# pipeline can read your pages must not silently open a metered box.
# Search — full text, fuzzy and graph — covers the same data for nothing.
ASSISTANT_ENABLED=

# Model routing, cheapest first. The one that matters for the bill is
# MODEL_DESCRIBE: a hundred panels per chapter, each carrying an image, is most
# of the spend on its own — and describing what is drawn, without naming anyone
# and without inferring, is the least demanding work in the pipeline.
# MODEL_EXTRACT is where a stronger model earns its price: entities, relations
# and events against the ontology. A weaker one there does not hallucinate into
# the graph (anchoring stops that) — it just finds less, and nobody learns what
# it missed.
# --- Self-hosted model (optional) ----------------------------------------
# An OpenAI-compatible endpoint — LM Studio, llama.cpp, vLLM. Setting the URL
# and the model is the decision to use it: the tiers listed in LOCAL_AI_TIERS
# go there, everything else falls through to the provider above. Name no tiers
# and it takes all of them.
#
# The endpoint usually listens on localhost of the machine holding the weights,
# so the worker has to run on that machine or reach it through a tunnel. It is
# never called from the browser.
#
# Cost is reported as zero for these calls, deliberately: the bill is
# electricity, and an invented figure would corrupt the cost dashboard.
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=
# Unlocks the semantic indexing step, which has declared itself skipped since
# the pipeline was written — Anthropic exposes no embeddings endpoint.
LOCAL_AI_EMBED_MODEL=
LOCAL_AI_API_KEY=
# classify, describe, extract, escalate, embed — comma separated. Empty = all.
# Moving one tier at a time is how you find out whether a smaller model is good
# enough at a given job: same chapter, compare the quarantine counts.
LOCAL_AI_TIERS=
# Tokens spent deliberating are GPU seconds producing no field of the answer.
LOCAL_AI_REASONING_EFFORT=none
# Délai maximal d'un appel, en millisecondes (défaut : 600000, soit 10 min).
# Un serveur qui accepte la connexion puis se fige ne doit pas retenir le
# pipeline pour toujours ; montez cette valeur si le matériel est juste lent.
LOCAL_AI_TIMEOUT_MS=

MODEL_CLASSIFY=claude-haiku-4-5
MODEL_DESCRIBE=claude-haiku-4-5
MODEL_EXTRACT=claude-sonnet-5
MODEL_ESCALATE=claude-opus-5

# Combien de réflexion l'extraction a le droit d'acheter : low | medium | high
# | xhigh | max, ou « adaptive » pour rendre au modèle sa posture par défaut.
#
# Vide = medium, réflexion étendue coupée. Mesuré sur le chapitre 1 : un résumé
# de 1 774 caractères produisait 23 190 tokens de sortie, deux minutes et 24
# centimes — quelques milliers de tokens de propositions, le reste en
# raisonnement, facturé au tarif de sortie et invisible dans la réponse. Sur
# onze cents chapitres c'est le budget du projet, et deux minutes dans une
# invocation tuée à cinq, c'est la marge d'un run qui va au bout.
#
# Ce qui garantit le graphe n'est pas là : l'ancrage s'exécute après la réponse
# et vérifie chaque citation caractère par caractère. Une passe moins profonde
# trouve un peu moins ; elle ne peut pas inventer davantage. Le rapprochement
# d'identités (MODEL_ESCALATE) n'est pas concerné — là, le raisonnement est le
# produit.
EXTRACT_EFFORT=

# Send bulk panel extraction through the Message Batches API (50% cheaper).
# Import is asynchronous by design, so this is the right default.
USE_BATCH_API=true

# Confidence below which a panel is escalated to the stronger model.
ESCALATION_CONFIDENCE_THRESHOLD=0.6

# --- Public reading -------------------------------------------------------
# Reading is public: the home page, the story mode, the graph, the timeline,
# the mysteries, the entity sheets and the search are open to anyone, each with
# their own chapter slider. Everything under /admin — sign-in, import, review,
# publication, deletion, export, enrichment, the assistant — needs the owner's
# session, and so do the page and panel images. Publishing the graph is what a
# fan wiki does; publishing the scans would be redistribution.
#
# This variable only answers *which* library the public site shows. Leave it
# empty and the sole library of this installation is used, which is what almost
# every deployment wants. Set it to a library id (shown in /admin/reglages) once
# the instance has more than one account: with several libraries and no id,
# nothing is published rather than one of them being guessed.
#
# A malformed value is treated as absent.
PUBLIC_LIBRARY_OWNER_ID=

# --- Illustrations --------------------------------------------------------
# Portraits, Devil Fruits, ships and islands are matched by name against three
# free public catalogues (onepieceapi.com, api-onepiece.com, AniList), then
# copied into the private bucket. No key, no account, nothing to configure.
# They are illustrations, never sources: no assertion may cite one.
#
# Une quinzaine d'entités sont illustrées automatiquement à chaque chapitre
# ouvert à la lecture ; le bouton des réglages rattrape le reste d'un coup.
#
# Where the fetched catalogue is cached. `pnpm images:catalogue` writes it;
# the test suite points this at a fixture so no test opens a socket. Laissé
# vide, le chemin est choisi selon l'endroit où le code tourne : `var/cache/`
# sur une machine à vous, `/tmp` sur un déploiement dont le disque est en
# lecture seule — là où `mkdir` échouait, ce qui faisait échouer tout
# l'enrichissement et laissait la bibliothèque sans une seule illustration.
IMAGE_CATALOGUE_PATH=

# --- Ingestion limits (defence in depth on untrusted uploads) -------------
MAX_UPLOAD_BYTES=524288000
MAX_PAGES_PER_CHAPTER=120
MAX_PIXELS_PER_PAGE=40000000
MAX_ARCHIVE_ENTRIES=500
MAX_DECOMPRESSION_RATIO=120

# Ne soumettre que les questions de nom à la revue, sur TOUTE la bibliothèque.
#
# Rarement ce que vous voulez : la même chose se demande par import, avec la case
# « traiter et publier le lot tout seul » sur /admin/import, qui ne concerne que
# les chapitres de ce lot-là (migration 0029, ADR 0013). Cette variable est le
# marteau : elle vaut aussi pour le chapitre unique collé dans trois mois.
#
# À 1, la dernière étape du pipeline accepte et publie les propositions sans les
# présenter, et ne laisse en attente que deux questions : les entités dont le
# modèle déclare ne pas savoir la forme française, et les rapprochements — « ce
# « Zoro » est-il le Roronoa Zoro du chapitre 2 ? » — avec, dans les deux cas,
# la proposition concernée et les relations qui en dépendent. Le chapitre
# s'ouvre dès qu'il ne reste rien à trancher.
#
# Les rapprochements restent humains parce qu'un « oui » automatique fabrique un
# second nœud que plus rien ne recolle : l'étape de rapprochement compare les
# candidats aux entités publiées, jamais les propositions entre elles.
#
# Ce que cela retire : identités, morts, affiliations cachées et résolutions de
# mystère entrent alors sans lecture humaine. Ce sont exactement les
# propositions que la revue explicite retient, et une erreur y réécrit ce que le
# lecteur savait aux chapitres antérieurs. Vide ou absent = revue complète.
AUTO_REVIEW_NAMES_ONLY=
